APP_NAME=AMpratas
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8090


APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3311
DB_DATABASE=ampratas
DB_USERNAME=ampratas
DB_PASSWORD=ampratas

SESSION_DRIVER=database
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
MEDIA_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="contato@ampratas.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=change_me
AWS_SECRET_ACCESS_KEY=change_me
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=ampratas
AWS_URL=http://localhost:9000/ampratas
AWS_ENDPOINT=http://localhost:9000
AWS_USE_PATH_STYLE_ENDPOINT=true


VITE_APP_NAME="${APP_NAME}"

PAYMENT_DEFAULT=manual_whatsapp
PAYMENT_PIX_ENABLED=true
PAYMENT_CARD_ENABLED=true
PAYMENT_DEBIT_ENABLED=true
MERCADOPAGO_SANDBOX=true
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_TEST_PAYER_EMAIL=
